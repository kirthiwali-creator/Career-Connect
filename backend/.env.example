# Port on which the Express server runs
PORT=5000

# MongoDB connection string
# Local MongoDB:   mongodb://127.0.0.1:27017/career_connect
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/career_connect
MONGO_URI=mongodb://127.0.0.1:27017/career_connect

# Secret key used to sign JWT tokens (change this to any long random text)
JWT_SECRET=career_connect_secret_key_change_me

# Frontend URL (allowed by CORS)
CLIENT_URL=http://localhost:5173
